#!/bin/sh
# =============================================================================
# openlogi-appimage-setup: the one-time setup behind "OpenLogi setup" / "remove"
# =============================================================================
#
# Why this exists
# ---------------
# When OpenLogi is installed as a normal package (.deb/.rpm), the system's
# package installer does two extra things automatically. An AppImage has no
# installer, so this script does them instead:
#
#   1. DEVICE RULES. Copies OpenLogi's own rules file (70-openlogi.rules, taken
#      unchanged from the official package) to /etc/udev/rules.d/. These rules
#      allow your user account to talk to Logitech receivers, read the mouse's
#      button presses, and send remapped actions. /etc is the part of an
#      immutable system (Bazzite, Silverblue, ...) that is meant for local
#      settings, so this is not layering and it survives system updates.
#      Writing to /etc needs your password once.
#
#   2. AUTOSTART. Writes a small systemd "user service" so OpenLogi's
#      background agent starts every time you log in. It has the same settings
#      as the service file OpenLogi ships in its packages; only the start
#      command differs: it starts your AppImage instead of /usr/bin/openlogi-agent.
#
# Setup also keeps a copy of the rules file it installed in your home folder
# (~/.local/share/openlogi-appimage/), so that after an update it can still
# recognise that file as its own, even if OpenLogi changes the rules.
#
# "remove" undoes all of this. Nothing here installs packages or changes the
# read-only system image, and neither setup nor remove ever replaces or deletes
# a file it didn't create: if a different file is already in the way, setup
# stops without changing anything, and remove leaves that file alone.
#
# Origin: this script was written for this repository. The rules file and the
# udevadm commands below come from OpenLogi's own packaging.
# =============================================================================

# Stop at the first error (-e) and treat unset variables as errors (-u), so a
# half-finished setup never silently looks like it worked.
set -eu

# Where the AppImage was unpacked. This script sits in usr/bin/, so "../.."
# goes back up to the top of the unpacked AppImage.
HERE="$(dirname "$(readlink -f "$0")")/../.."

# --- Device rules ------------------------------------------------------------
RULES_NAME=70-openlogi.rules
# TEST_ROOT is only set by the automatic test (tests/test-setup.sh), which
# points everything at a throwaway folder. In normal use it is empty.
TEST_ROOT="${OPENLOGI_SETUP_TEST_ROOT:-}"
RULES_DEST=$TEST_ROOT/etc/udev/rules.d/$RULES_NAME

# The copy of the rules file that setup installed (see "rules_ours" below).
STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/openlogi-appimage"
RULES_RECORD="$STATE_DIR/installed-$RULES_NAME"

# --- Autostart service -------------------------------------------------------
# We put the service file where OpenLogi's agent looks for its own one
# (~/.local/share/systemd/user/). Background: when the agent starts, it writes
# its own autostart file there. Inside an AppImage that file points into the
# temporary unpack folder, which disappears on reboot, so it would be useless.
# Ours replaces it, and the agent leaves alone a file it did not write itself.
UNIT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/systemd/user"
UNIT="$UNIT_DIR/openlogi-agent.service"

# The first version of this setup put the file in ~/.config/systemd/user/
# instead. If one of ours is still there, it would win over the new one, so we
# clean it up. Only a file containing our own marker line is ever deleted.
OLD_UNIT="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/openlogi-agent.service"

drop_old_unit() {
  if grep -q 'Written by the OpenLogi AppImage setup' "$OLD_UNIT" 2>/dev/null; then
    rm -f "$OLD_UNIT"
  fi
}

# --- Never touch files this setup didn't make ---------------------------------
# is_ours_unit: the service file carries our marker line, or it's the throwaway
# file OpenLogi's agent writes itself (it points into the AppImage's temporary
# unpack folder, /tmp/.mount_...). Anything else belongs to someone else.
is_ours_unit() {
  grep -q 'Written by the OpenLogi AppImage setup' "$1" 2>/dev/null \
    || grep -q '^ExecStart=.*/tmp/\.mount_' "$1" 2>/dev/null
}

# same_rules: the rules file in /etc is identical to OpenLogi's own one inside
# this AppImage (for example from an earlier setup, or from OpenLogi's package).
same_rules() {
  cmp -s "$HERE/usr/lib/openlogi/$RULES_NAME" "$RULES_DEST"
}

# rules_ours: the rules file in /etc is OpenLogi's current one (above), or it is
# exactly the file an earlier setup installed (setup keeps a copy of it). The
# second case matters after an update that changes OpenLogi's rules: the old
# file is still recognised as ours, so setup can update it and remove can
# delete it. Any other file belongs to someone else.
rules_ours() {
  same_rules || { [ -s "$RULES_RECORD" ] && cmp -s "$RULES_RECORD" "$RULES_DEST"; }
}

# Run a command with administrator rights. pkexec shows a graphical password
# prompt; sudo (asks in the terminal) is the fallback if pkexec isn't there.
as_root() {
  if command -v pkexec >/dev/null 2>&1; then pkexec "$@"; else sudo "$@"; fi
}

# =============================================================================
# setup
# =============================================================================
install_all() {
  # $APPIMAGE is set by the AppImage itself and holds the path of the
  # .AppImage file (e.g. ~/Applications/OpenLogi). The autostart service needs
  # that path, so this only works when started through the AppImage.
  if [ -z "${APPIMAGE:-}" ]; then
    echo "Run this through the AppImage: ./OpenLogi-*.AppImage setup" >&2
    exit 1
  fi

  # --- Step 1: device rules --------------------------------------------------
  # Refuse to replace a different file someone else put there.
  if [ -e "$RULES_DEST" ] && ! rules_ours; then
    echo "Stopped: $RULES_DEST already exists and wasn't installed by this setup." >&2
    echo "Nothing was changed. Rename or remove that file yourself, then run setup again." >&2
    echo "(If an older version of this AppImage installed it, it's safe to delete it.)" >&2
    exit 1
  fi
  # Same check for the service file, before anything is changed.
  if [ -e "$UNIT" ] && ! is_ours_unit "$UNIT"; then
    echo "Stopped: $UNIT already exists and wasn't written by this setup or by OpenLogi." >&2
    echo "Nothing was changed. Rename or remove that file yourself, then run setup again." >&2
    exit 1
  fi

  echo "1/2  Installing device rules to $RULES_DEST (you may be asked for your password)"

  if same_rules; then
    echo "     Already in place, nothing to do."
  else
  # The administrator account can't look inside the AppImage's temporary
  # folder (it belongs to your user only), so first copy the rules file to a
  # normal temporary file that it can read.
  tmp="$(mktemp)"
  # Delete this temporary copy when the script ends, also if it stops early
  # (for example because you cancelled the password prompt or pressed Ctrl+C).
  trap 'rm -f "$tmp"' EXIT
  trap 'exit 130' INT TERM
  cp "$HERE/usr/lib/openlogi/$RULES_NAME" "$tmp"
  chmod 644 "$tmp"

  # Everything that needs administrator rights runs in one go, so you're asked
  # for your password only once:
  #   install ...         copy the rules file to /etc/udev/rules.d/
  #   udevadm control     tell the system to re-read its device rules
  #   udevadm trigger     re-apply them to devices that are already plugged in,
  #                       so no reboot or re-plugging is needed
  #   udevadm settle      wait until that's finished
  # These udevadm commands are the same ones OpenLogi's own package runs.
  # The two file paths are handed over separately ("$1" and "$2") rather than
  # pasted into the command text, so an unusual character in a path can never
  # change what the administrator command does.
  as_root sh -c 'install -m 644 "$1" "$2" \
    && udevadm control --reload-rules \
    && udevadm trigger --subsystem-match=hidraw \
    && udevadm trigger --subsystem-match=input \
    && (udevadm trigger --subsystem-match=misc --attr-match=name=uinput || true) \
    && (udevadm settle || true)' sh "$tmp" "$RULES_DEST"
  fi

  # Remember exactly which rules file was installed (see "rules_ours").
  mkdir -p "$STATE_DIR"
  cp "$HERE/usr/lib/openlogi/$RULES_NAME" "$RULES_RECORD"

  # --- Step 2: autostart service --------------------------------------------
  echo "2/2  Starting the OpenLogi agent on login (from $APPIMAGE)"
  drop_old_unit
  mkdir -p "$UNIT_DIR"

  # Write the service file. Apart from the first comment line, the Description
  # and the ExecStart line, it matches the openlogi-agent.service that
  # OpenLogi ships:
  #   After=graphical-session.target   start once your desktop is up
  #   ExecStart=... agent              run the agent from your AppImage
  #   Restart=on-failure, RestartSec=5 if the agent crashes, restart it after 5 s
  #   WantedBy=graphical-session.target  start it with every desktop login
  cat > "$UNIT" <<EOF
# Written by the OpenLogi AppImage setup. Re-run "setup" if you move the AppImage.
[Unit]
Description=OpenLogi background agent (AppImage)
After=graphical-session.target

[Service]
Type=simple
ExecStart="$APPIMAGE" agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
EOF

  # daemon-reload: let systemd notice the new file.
  # enable:        start it automatically on every login (this creates the
  #                link in ~/.config/systemd/user/graphical-session.target.wants/).
  # restart:       start it right now as well, replacing any agent already running.
  systemctl --user daemon-reload
  systemctl --user enable openlogi-agent.service
  systemctl --user restart openlogi-agent.service

  echo
  echo "Done. The agent is running and will start on every login."
  echo "If you move or rename the AppImage, run setup again."
}

# =============================================================================
# remove: undo everything setup did
# =============================================================================
remove_all() {
  echo "1/2  Stopping and removing the agent autostart"
  # Stop the agent and switch off autostart, but only if the autostart file is
  # ours (from this setup, an older version of it, or OpenLogi's own throwaway
  # one). "|| true" means: if it was already off, that's fine, carry on.
  if [ -e "$UNIT" ] && ! is_ours_unit "$UNIT"; then
    # Not ours: leave the service and its file completely alone.
    echo "     Skipped: $UNIT wasn't written by this setup, so it's left alone."
  elif [ -e "$UNIT" ] || grep -q 'Written by the OpenLogi AppImage setup' "$OLD_UNIT" 2>/dev/null; then
    systemctl --user disable --now openlogi-agent.service 2>/dev/null || true
    rm -f "$UNIT"
  else
    # None of our files are there. A service with this name from somewhere
    # else (for example one you wrote yourself) is left running.
    echo "     Already removed, nothing to do."
  fi
  drop_old_unit
  systemctl --user daemon-reload || true

  # Remove the device rules again, if they're there (needs your password).
  # Only remove the rules file if setup installed it.
  if [ -e "$RULES_DEST" ] && ! rules_ours; then
    echo "2/2  Skipped: $RULES_DEST wasn't installed by this setup, so it's left alone."
    echo "     (If an older version of this AppImage installed it, it's safe to delete it yourself.)"
  elif [ -e "$RULES_DEST" ]; then
    echo "2/2  Removing $RULES_DEST (you may be asked for your password)"
    # Delete the file, then make the system re-read its rules and take the
    # permissions away from devices that are plugged in right now: the same
    # devices setup refreshes. The path is handed over as "$1", as in setup.
    as_root sh -c 'rm -f "$1" \
      && udevadm control --reload-rules \
      && udevadm trigger --subsystem-match=hidraw \
      && udevadm trigger --subsystem-match=input \
      && (udevadm trigger --subsystem-match=misc --attr-match=name=uinput || true) \
      && (udevadm settle || true)' sh "$RULES_DEST"
  else
    echo "2/2  Device rules already removed, nothing to do."
  fi
  # Forget the copy setup kept. (If the password prompt above was cancelled,
  # the script has already stopped and the copy stays, so running remove again
  # still works.)
  rm -f "$RULES_RECORD"
  rmdir "$STATE_DIR" 2>/dev/null || true

  echo "Done."
  echo
  echo "Uninstalling OpenLogi? If its window is open, quit it (tray icon > Quit), then"
  echo "uninstall the AppImage (for example in AppManager) without opening it again."
  echo "OpenLogi has its own \"Launch at login\" setting, on by default, so whenever it"
  echo "runs it sets up autostart again by itself."
  echo "To keep OpenLogi but stop it starting at login, turn off"
  echo "Settings > General > Launch at login in OpenLogi instead."
}

# =============================================================================
# Pick what to do. AppRun passes "install" for "setup" and "remove" for "remove".
# =============================================================================
case "${1:-install}" in
  install) install_all ;;
  remove)  remove_all ;;
  *) echo "usage: setup | remove" >&2; exit 2 ;;
esac
